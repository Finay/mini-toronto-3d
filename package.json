{
  "name": "mini-toronto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data": "tsx scripts/build-gtfs-data.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@deck.gl/mesh-layers": "^9.4.0",
    "@fontsource/russo-one": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@luma.gl/engine": "^9.4.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "hono": "^4.13.13",
    "maplibre-gl": "^6.13.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "happy-dom": "^20.14.5",
    "node-stream-zip": "^1.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
